# FL26 Live Transfer Updater Configuration

# Path to user's Football Life 26 EDIT00000000 file
EDIT_FILE=/path/to/EDIT00000000

# Backup directory for EDIT snapshots
BACKUP_DIR=./backups

# Output directory for generated artifacts
OUTPUT_DIR=./output

# SQLite database for transfer history
DATABASE_PATH=./data/transfers.db

# Scan interval (minutes)
SCAN_INTERVAL_MINUTES=15

# Deep scan interval (hours)
DEEP_SCAN_INTERVAL_HOURS=6

# Confidence threshold for automatic application (0-100)
AUTO_APPLY_THRESHOLD=99

# Confidence threshold for review queue (0-100)
REVIEW_THRESHOLD=80

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable sources
ENABLE_FOTMOB=true
ENABLE_TRANSFERMARKT=false

# API rate limits
FOTMOB_RATE_LIMIT=100
FOTMOB_RATE_LIMIT_WINDOW_SECONDS=3600

# GitHub Actions (optional)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
